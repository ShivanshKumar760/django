    {
      "id": "M0wYlUxO5hwj1l82IoiA0",
      "type": "text",
      "x": 322.8570861816406,
      "y": 112.78575134277344,
      "width": 908.5997314453125,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",

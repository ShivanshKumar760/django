      "boundElements": null,
      "updated": 1781249062576,
      "link": null,
      "locked": false,
      "text": "ModelSerializer inspects the model and generates fields,\ncreate(), and update() automatically. You only declare what\ndiffers from the default.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ModelSerializer inspects the model and generates fields, create(), and update() automatically. You only declare what differs from the default.",

    {
      "id": "KH6KDcPL-u4YQMsQeb4bD",
      "type": "text",
      "x": 399.2386402289346,
      "y": 28133.18536537693,
      "width": 748,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brQ",
      "roundness": null,
      "seed": 1601806642,
      "version": 80,
      "versionNonce": 606316846,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769944175396,
      "link": null,
      "locked": false,
      "text": "But this website will change on Christmas day, when the website will\nsay YES. To make something like this for ourselves, let’s try\ncreating a similar application, where we check whether or not it is\nNew Year’s Day. Let’s create a new app to do so, recalling our\nprocess for creating a new app:\n\n1.run python manage.py startapp newyear in the terminal.\n2.Edit settings.py, adding “newyear” as one of our INSTALLED_APPS\n\n3.Edit our project’s urls.py file, and include a path similar to the\none we created for the hello app:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But this website will change on Christmas day, when the website will say YES. To make something like this for ourselves, let’s try creating a similar application, where we check whether or not it is New Year’s Day. Let’s create a new app to do so, recalling our process for creating a new app:\n\n1.run python manage.py startapp newyear in the terminal.\n2.Edit settings.py, adding “newyear” as one of our INSTALLED_APPS\n\n3.Edit our project’s urls.py file, and include a path similar to the one we created for the hello app:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "v4V7svrSfYz5v_ae_YwoC",
      "type": "text",
      "x": 421.47304559695704,
      "y": 28433.008657241717,
      "width": 451,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brR",
      "roundness": null,
      "seed": 1103810542,
      "version": 86,
      "versionNonce": 49332914,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769944193407,
      "link": null,
      "locked": false,
      "text": "path('newyear/', include(\"newyear.urls\"))",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "path('newyear/', include(\"newyear.urls\"))",
      "autoResize": true,
      "lineHeight": 1.25
    },

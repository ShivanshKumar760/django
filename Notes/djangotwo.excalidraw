    {
      "id": "AU3-SKfAyqWS_Gafv0mxb",
      "type": "text",
      "x": 370.4064445685517,
      "y": 23001.27109173125,
      "width": 704,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqm",

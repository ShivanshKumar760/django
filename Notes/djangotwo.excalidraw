    {
      "id": "tX5y_B8J5C95UnLi-9qN7",
      "type": "text",
      "x": 432.73156476740553,
      "y": 10131.907825999686,
      "width": 748,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bpk",
      "roundness": null,
      "seed": 1932657747,
      "version": 62,
      "versionNonce": 1533591037,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769930936196,
      "link": null,
      "locked": false,
      "text": "Django is a Python framework that simplifies web development by\nhandling complex tasks for you. It follows the \"Don't Repeat\nYourself\" (DRY) principle, promoting reusable components and making\ndevelopment faster. With built-in features like user authentication,\ndatabase connections, and CRUD operations, Django lets you focus on\nbuilding your web applications without reinventing the wheel.\n\nWorking of Django\nDjango uses the MVT (Model-View-Template) design pattern:\n\n-Model: Represents the data you want to display, typically sourced\nfrom a database.\n\n-View: Handles incoming requests and returns the appropriate\ntemplate and content based on the user's request.\n\n-Template: A text file (usually HTML) that defines the structure of\nthe web page and includes logic for displaying the data.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Django is a Python framework that simplifies web development by handling complex tasks for you. It follows the \"Don't Repeat Yourself\" (DRY) principle, promoting reusable components and making development faster. With built-in features like user authentication, database connections, and CRUD operations, Django lets you focus on building your web applications without reinventing the wheel.\n\nWorking of Django\nDjango uses the MVT (Model-View-Template) design pattern:\n\n-Model: Represents the data you want to display, typically sourced from a database.\n\n-View: Handles incoming requests and returns the appropriate template and content based on the user's request.\n\n-Template: A text file (usually HTML) that defines the structure of the web page and includes logic for displaying the data.",
      "autoResize": false,
      "lineHeight": 1.25
    },

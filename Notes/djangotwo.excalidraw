      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brI",
      "roundness": null,
      "seed": 1363902130,
      "version": 23,
      "versionNonce": 816215790,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769943869728,
      "link": null,
      "locked": false,
      "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <title>Hello</title>\n    </head>\n    <body>\n        <h1>Hello, {{ name }}!</h1>\n    </body>\n</html>",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,

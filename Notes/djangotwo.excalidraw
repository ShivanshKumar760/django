    {
      "id": "nrNYL8--pFmoRRFIANDCU",
      "type": "text",
      "x": 393.3104883848023,
      "y": 27531.90287250463,
      "width": 748,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

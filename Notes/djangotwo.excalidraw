    {
      "id": "K9B1gxpJzTlU-49sK3amS",
      "type": "text",
      "x": 417.1429138183594,
      "y": 268.00006103515625,
      "width": 814,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "boq",
      "roundness": null,
      "seed": 1811930845,
      "version": 110,
      "versionNonce": 240029747,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769927014974,
      "link": null,
      "locked": false,
      "text": "So in this module we will see how to create a backend using python backend\nframework django ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So in this module we will see how to create a backend using python backend\nframework django ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QTnicbxc_z0T7Cseak7NI",
      "type": "text",
      "x": 399.4285888671875,
      "y": 381.71429443359375,
      "width": 869,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bor",
      "roundness": null,
      "seed": 687542770,
      "version": 487,
      "versionNonce": 1209430898,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769927315889,
      "link": null,
      "locked": false,
      "text": "Why do we need backend framework like django ,express.js or spring boot \nwell the answer is our frontend is made using html,css and js now js may add\ninteractivity but as whole the frontend is static it needs data which it \ncan integrate in itself to make it dynamic and that data comes from backend\nusing server application and models(data bases) and thats where framework like \ndjango comes into play",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why do we need backend framework like django ,express.js or spring boot \nwell the answer is our frontend is made using html,css and js now js may add\ninteractivity but as whole the frontend is static it needs data which it \ncan integrate in itself to make it dynamic and that data comes from backend\nusing server application and models(data bases) and thats where framework like \ndjango comes into play",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ekIUa91Wz5-x9lC59dAjt",
      "type": "text",
      "x": 390.2857666015625,
      "y": 607.0000610351562,
      "width": 847,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

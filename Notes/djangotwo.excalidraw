    {
      "id": "SBX928uRX8HNnwZCkt1AA",
      "type": "text",
      "x": 360.14725776762407,
      "y": 14930.448717384817,
      "width": 726,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqC",
      "roundness": null,
      "seed": 715438749,
      "version": 96,
      "versionNonce": 917419859,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769931940492,
      "link": null,
      "locked": false,
      "text": "Installing Django\nFollow these steps to set up Django on your system:\n\n1. Install Python 3:\nDownload and install the latest Python 3 version from the official\nwebsite.\n\n2. Install pip:\nPip comes with recent versions of Python. Open the command prompt\nand run:\n\n[$pip install django]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Installing Django\nFollow these steps to set up Django on your system:\n\n1. Install Python 3:\nDownload and install the latest Python 3 version from the official website.\n\n2. Install pip:\nPip comes with recent versions of Python. Open the command prompt and run:\n\n[$pip install django]",
      "autoResize": false,
      "lineHeight": 1.25

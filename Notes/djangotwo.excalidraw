    {
      "id": "o5BbQ7e6Ph7OvOxDJ1FvQ",
      "type": "text",
      "x": 377.30512424279254,
      "y": 29393.946887063026,
      "width": 748,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

    {
      "id": "d9ZNegBE2RJRuLVDtQVhM",
      "type": "text",
      "x": 367.45902130863374,
      "y": 28503.38596185814,
      "width": 693,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",

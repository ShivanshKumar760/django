      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brK",
      "roundness": null,
      "seed": 1317114226,
      "version": 55,
      "versionNonce": 1135036462,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769944120408,
      "link": null,
      "locked": false,
      "text": "Conditionals:\nWe may want to change what is displayed on our website depending on\nsome conditions. For example, if you visit the site\nwww.isitchristmas.com, you’ll probably be met with a page that looks\nlike this:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Conditionals:\nWe may want to change what is displayed on our website depending on some conditions. For example, if you visit the site www.isitchristmas.com, you’ll probably be met with a page that looks like this:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "j7fkCXxtXpNL1JvcJTGKI",
      "type": "image",
      "x": 398.9841986738045,
      "y": 27680.284111984416,
      "width": 633.5065617030845,
      "height": 405.6201735348916,
      "angle": 0,
      "strokeColor": "transparent",

    {
      "id": "rw_QTtOPqXG_q18JakFct",
      "type": "text",
      "x": 385.5504200338965,
      "y": 2325.3182186392623,
      "width": 1023,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bpI",
      "roundness": null,
      "seed": 933729586,
      "version": 591,
      "versionNonce": 327098222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769929591584,
      "link": null,
      "locked": false,
      "text": "Alternate solution is \n1.Rent a VM via AWS,Azure,GCP or a digital ocean droplet ->they have elastic ip or also known\nas public ip\n\n2.PORT forwarding ->go to your router gateway and login into it and forward the port / allow\nit for incomming traffic (Security risk are involved)\n\n3.Tunelling:we can use cloudlflare tunnel or ngrok to tunnel our machine via there public \nnetwrok so the frontend will send request to cloudflare ip which will then get tunnel to \nour machine ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Alternate solution is \n1.Rent a VM via AWS,Azure,GCP or a digital ocean droplet ->they have elastic ip or also known\nas public ip\n\n2.PORT forwarding ->go to your router gateway and login into it and forward the port / allow\nit for incomming traffic (Security risk are involved)\n\n3.Tunelling:we can use cloudlflare tunnel or ngrok to tunnel our machine via there public \nnetwrok so the frontend will send request to cloudflare ip which will then get tunnel to \nour machine ",
      "autoResize": true,
      "lineHeight": 1.25
    },

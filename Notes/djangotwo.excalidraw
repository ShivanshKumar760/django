      "seed": 1959300846,
      "version": 55,
      "versionNonce": 2030359922,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769943840845,
      "link": null,
      "locked": false,
      "text": "In addition to writing some static HTML pages, we can also use\nDjango’s templating language to change the content of our HTML files\nbased on the URL visited. Let’s try it out by changing our greet\nfunction from earlier:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In addition to writing some static HTML pages, we can also use Django’s templating language to change the content of our HTML files based on the URL visited. Let’s try it out by changing our greet function from earlier:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "XMH2nD-zo9zpMQQiF_rEj",
      "type": "text",
      "x": 416.169771490534,
      "y": 27075.501739013936,
      "width": 528,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brG",
      "roundness": null,
      "seed": 2099027758,
      "version": 46,
      "versionNonce": 522611058,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769943853711,
      "link": null,
      "locked": false,
      "text": "def greet(request, name):\n    return render(request, \"hello/greet.html\", {\n        \"name\": name.capitalize()\n    })",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def greet(request, name):\n    return render(request, \"hello/greet.html\", {\n        \"name\": name.capitalize()\n    })",
      "autoResize": true,
      "lineHeight": 1.25
    },

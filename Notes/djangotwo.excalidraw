    {
      "id": "8T_tWq--pW3w8gno2LEGO",
      "type": "text",
      "x": 402.20252619889857,
      "y": 26940.937216178034,
      "width": 748,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brF",

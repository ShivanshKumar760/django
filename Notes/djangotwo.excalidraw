      "seed": 1709453874,
      "version": 88,
      "versionNonce": 742075442,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769938480981,
      "link": null,
      "locked": false,
      "text": "I can even make these look a little bit nicer, by augmenting the\ngreet function to utilize Python’s capitalize function that\ncapitalizes a string:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I can even make these look a little bit nicer, by augmenting the greet function to utilize Python’s capitalize function that capitalizes a string:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "tC0-RYffZRbulJhGLdTfn",
      "type": "text",
      "x": 379.00348851833394,
      "y": 23109.211132562992,
      "width": 605,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqp",
      "roundness": null,
      "seed": 778060786,
      "version": 85,
      "versionNonce": 948017454,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769938493364,
      "link": null,
      "locked": false,
      "text": "def greet(request, name):\n    return HttpResponse(f\"Hello, {name.capitalize()}!\")",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def greet(request, name):\n    return HttpResponse(f\"Hello, {name.capitalize()}!\")",
      "autoResize": true,
      "lineHeight": 1.25

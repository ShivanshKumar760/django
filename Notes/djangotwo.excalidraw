      "groupIds": [],
      "frameId": null,
      "index": "brT",
      "roundness": null,
      "seed": 1379456818,
      "version": 120,
      "versionNonce": 1810348274,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769944246856,
      "link": null,
      "locked": false,
      "text": "Create another urls.py file within our new app’s directory, and\nupdate it to include a path similar to the index path in hello:\n\nfrom django.urls import path\nfrom . import views\n\nurlpatterns = [\n    path(\"\", views.index, name=\"index\"),\n]\nCreate an index function in views.py.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Create another urls.py file within our new app’s directory, and update it to include a path similar to the index path in hello:\n\nfrom django.urls import path\nfrom . import views\n\nurlpatterns = [\n    path(\"\", views.index, name=\"index\"),\n]\nCreate an index function in views.py.",
      "autoResize": false,
      "lineHeight": 1.25
    },

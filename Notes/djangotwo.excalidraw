      "isDeleted": false,
      "boundElements": null,
      "updated": 1769943708078,
      "link": null,
      "locked": false,
      "text": "One thing we need to remember is when we \n1.django-admin startproject <project-name>\n2.cd <project-name>\n3.python manage.py startapp <application-name>\n\n4.we need to add this application name under <project-name>/settings.py\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One thing we need to remember is when we \n1.django-admin startproject <project-name>\n2.cd <project-name>\n3.python manage.py startapp <application-name>\n\n4.we need to add this application name under <project-name>/settings.py\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

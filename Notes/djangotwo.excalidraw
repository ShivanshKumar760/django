      "isDeleted": false,
      "boundElements": null,
      "updated": 1769944302210,
      "link": null,
      "locked": false,
      "text": "def index(request):\n    now = datetime.datetime.now()\n    return render(request, \"newyear/index.html\", {\n        \"newyear\": now.month == 1 and now.day == 1\n    })",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def index(request):\n    now = datetime.datetime.now()\n    return render(request, \"newyear/index.html\", {\n        \"newyear\": now.month == 1 and now.day == 1\n    })",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {

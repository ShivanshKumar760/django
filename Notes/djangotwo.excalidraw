    {
      "id": "xCTx1gTGeOePLjngywibZ",
      "type": "text",
      "x": 400.572420574102,
      "y": 18307.244379082185,
      "width": 1049.1400588839765,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",

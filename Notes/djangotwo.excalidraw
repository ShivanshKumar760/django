    {
      "id": "mJ-gH7BAdOkZQw4LLHXi8",
      "type": "text",
      "x": 385.1598336260852,
      "y": 19180.540111597813,
      "width": 1168.2917573317343,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqO",
      "roundness": null,
      "seed": 812262638,
      "version": 107,
      "versionNonce": 304146094,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769937072368,
      "link": null,
      "locked": false,
      "text": "4.Now, we’ve created a urls.py for this specific application, and it’s time to edit the urls.py created\nfor us for the entire project. When you open this file, you should see that there’s already a path called\nadmin which we’ll go over in later lectures. We want to add another path for our new app, so we’ll add an\nitem to the urlpatterns list. This follows the same pattern as our earlier paths, except instead of adding\na function from views.py as our second argument, we want to be able to include all of the paths from the\nurls.py file within our application. To do this, we write: include(\"APP_NAME.urls\"), where include is a\nfunction we gain access to by also importing include from django.urls as shown in the urls.py below:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4.Now, we’ve created a urls.py for this specific application, and it’s time to edit the urls.py created for us for the entire project. When you open this file, you should see that there’s already a path called admin which we’ll go over in later lectures. We want to add another path for our new app, so we’ll add an item to the urlpatterns list. This follows the same pattern as our earlier paths, except instead of adding a function from views.py as our second argument, we want to be able to include all of the paths from the urls.py file within our application. To do this, we write: include(\"APP_NAME.urls\"), where include is a function we gain access to by also importing include from django.urls as shown in the urls.py below:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "9DWVyXhs_HKvHnZTMPAKt",
      "type": "text",
      "x": 387.2392128833626,
      "y": 19381.0133407393,
      "width": 451,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bqV",
      "roundness": null,
      "seed": 2133248686,
      "version": 11,
      "versionNonce": 2055407794,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769937090750,
      "link": null,
      "locked": false,
      "text": "from django.contrib import admin\nfrom django.urls import path, include\n\nurlpatterns = [\n    path('admin/', admin.site.urls),\n    path('hello/', include(\"hello.urls\"))\n]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from django.contrib import admin\nfrom django.urls import path, include\n\nurlpatterns = [\n    path('admin/', admin.site.urls),\n    path('hello/', include(\"hello.urls\"))\n]",
      "autoResize": true,
      "lineHeight": 1.25
    },
